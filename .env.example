AI_PROVIDER=auto

# Free/low-cost cloud fallback chain for Vercel.
# Add any keys you have; the app skips missing providers.
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-2.5-flash-lite

# GROQ_API_KEY=your_groq_api_key_here
# GROQ_MODEL=llama-3.1-8b-instant
# Optional: override the OpenAI-compatible Groq endpoint.
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenRouter can route to free models with one key.
# OPENROUTER_API_KEY=your_openrouter_api_key_here
# OPENROUTER_MODEL=openrouter/free
# OPENROUTER_SITE_URL=https://your-vercel-domain.vercel.app
# OPENROUTER_APP_NAME=IELTS PDF Helper

# Local Ollama example for zero cloud quota on your own computer.
# Do not use this 127.0.0.1 URL on Vercel.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5-coder:7b

# Ollama cloud example:
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_MODEL=glm-5.2
# OLLAMA_API_KEY=your_ollama_api_key_here
# If you use a local Ollama app with cloud offload instead of https://ollama.com/api,
# use OLLAMA_MODEL=glm-5.2:cloud.
# Optional: required for scanned/image-only PDF selections.
# Ollama's vision docs use gemma4 as the image-capable example model.
# OLLAMA_VISION_MODEL=gemma4

# Optional paid fallback. Leave unset if you only want free providers.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-5.5

# Optional account login for automatic per-user cloud backup.
# Get these from Clerk Dashboard -> API keys.
# Add the same values in Vercel Project Settings -> Environment Variables.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_or_pk_live...
# CLERK_SECRET_KEY=sk_test_or_sk_live...

# Optional cloud sync for moving local IndexedDB data between devices.
# Keep the service role key server-side only. Never expose it as NEXT_PUBLIC_*.
# With Clerk configured, cloud paths are owned by the signed-in user automatically.
# Without Clerk, the app falls back to manual sync-code paths.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
# SUPABASE_SYNC_BUCKET=ielts-sync
